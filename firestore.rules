rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && prof().active == true; }
    function role() { return prof().role; }
    function isAdmin() { return active() && role() == 'admin'; }
    function isMgr() { return active() && role() in ['admin', 'manager']; }
    function isBiz() { return active() && role() in ['admin', 'manager', 'accountant']; }
    function canPost() { return active() && role() in ['admin', 'manager', 'accountant', 'operator']; }
    function isAtt() { return active() && role() in ['admin', 'manager', 'accountant', 'operator', 'employee']; }
    function isDriver() { return active() && role() == 'driver'; }

    // ---- Users & first-time setup ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || (isBiz() && resource.data.role == 'driver'));
      allow create: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == 'admin'
                        && !exists(/databases/$(database)/documents/meta/bootstrap))
                       || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }
    match /meta/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == 'bootstrap' && !exists(/databases/$(database)/documents/meta/bootstrap);
      allow update, delete: if false;
    }

    // ---- Settings & counters ----
    match /settings/{id} {
      allow read: if canPost();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /counters/{id} { allow read: if canPost(); allow create, update: if isBiz(); allow delete: if false; }

    // ---- Masters ----
    match /suppliers/{id} { allow read: if canPost(); allow create, update: if isBiz(); allow delete: if isAdmin(); }
    match /customers/{id} { allow read: if canPost(); allow create, update: if isBiz(); allow delete: if isAdmin(); }
    match /employees/{id} { allow read: if isBiz(); allow create, update: if isMgr(); allow delete: if isAdmin(); }
    match /labour/{id}    { allow read: if isBiz(); allow create, update: if isMgr(); allow delete: if isAdmin(); }
    match /attendanceRoster/{id} { allow read: if isAtt(); allow create, update: if isMgr(); allow delete: if isAdmin(); }
    match /machines/{id}  { allow read: if canPost(); allow create, update: if isMgr(); allow delete: if isAdmin(); }
    match /godowns/{id}   { allow read: if canPost(); allow create, update: if isMgr(); allow delete: if isAdmin(); }
    match /tanks/{id} {
      allow read: if canPost();
      allow create: if isMgr();
      allow update: if isMgr() ||
        (canPost() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['oilKg', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ---- Stock ----
    match /stock/{id} { allow read: if canPost(); allow create, update: if canPost(); allow delete: if false; }
    match /stockLedger/{id} { allow read: if canPost(); allow create: if canPost(); allow update, delete: if false; }
    match /tankLedger/{id}  { allow read: if canPost(); allow create: if canPost(); allow update, delete: if false; }

    // ---- Transactions: never deleted. Stock-affecting ones can only be VOIDED by admin. ----
    match /purchases/{id} {
      allow read: if canPost();
      allow create: if isBiz();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'updatedAt']);
      allow delete: if isAdmin() && resource.data.status == 'Voided';
    }
    match /productions/{id} {
      allow read: if canPost();
      allow create: if canPost();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'updatedAt']);
      allow delete: if isAdmin() && resource.data.status == 'Voided';
    }
    match /docPurchases/{id} {
      allow read: if canPost();
      allow create: if isBiz();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'updatedAt']);
      allow delete: if isAdmin() && resource.data.status == 'Voided';
    }
    match /supplierPayments/{id} { allow read: if canPost(); allow create: if isBiz(); allow update: if isAdmin(); allow delete: if isAdmin(); }
    match /expenses/{id}         { allow read: if canPost(); allow create: if isBiz(); allow update: if isAdmin(); allow delete: if isAdmin(); }
    match /qcRecords/{id}        { allow read: if canPost(); allow create: if canPost(); allow update: if isAdmin(); allow delete: if isAdmin(); }
    match /payroll/{id}          { allow read: if isMgr(); allow create: if isMgr(); allow update: if false; allow delete: if isAdmin(); }

    // ---- Attendance: employee role may ONLY create (enter) records ----
    match /attendance/{id}       { allow read: if isAtt(); allow create: if isAtt(); allow update: if canPost(); allow delete: if isAdmin(); }
    match /labourAttendance/{id} { allow read: if isAtt(); allow create: if isAtt(); allow update: if canPost(); allow delete: if isAdmin(); }

    match /invoices/{id} {
      allow read: if canPost();
      allow create: if isBiz();
      allow update: if isBiz() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'deliveredAt', 'cancelReason', 'updatedAt', 'irn', 'irnDate', 'ewayBillNo', 'ewayValidUpto']);
      allow delete: if isAdmin() && resource.data.status == 'Cancelled';
    }

    // ---- Shipments & driver tracking ----
    match /shipments/{id} {
      allow read: if isBiz() || (isDriver() && resource.data.driverUid == request.auth.uid);
      allow create: if isBiz();
      allow update: if (isBiz() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'vehicleNo', 'driverUid', 'driverName', 'updatedAt']))
        || (isDriver() && resource.data.driverUid == request.auth.uid
            && resource.data.status != 'Delivered'
            && request.resource.data.status in ['In transit', 'Delivered']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['status', 'lastLat', 'lastLng', 'lastAt', 'deliveredAt', 'deliveryNote', 'updatedAt']));
      allow delete: if isAdmin();
    }
    // Public tracking page: anyone WITH the random link id can read that one document (no listing).
    match /tracking/{id} {
      allow get: if true;
      allow list: if isBiz();
      allow create: if isBiz();
      allow update: if isBiz()
        || (isDriver()
            && get(/databases/$(database)/documents/shipments/$(id)).data.driverUid == request.auth.uid
            && resource.data.status != 'Delivered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['status', 'lastLat', 'lastLng', 'lastAt', 'deliveredAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ---- Audit trail ----
    match /auditLogs/{id} {
      allow read: if isMgr();
      allow create: if active() && role() != 'driver';
      allow update, delete: if false;
    }
  }
}
